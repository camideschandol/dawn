{%- comment -%}
  Poivre Paris — tabs row rendered at body level (sibling of <main>).
  Lives outside any Shopify section wrapper so position: sticky on
  .header__tabs has the body as its containing block — i.e. it stays
  pinned across the full page scroll, not just the header section.

  Mirrors what previously lived inside header.liquid's .header__tabs
  block (MENU drawer, inline dropdown nav, SEARCH, CART). Links come
  from linklists['main-menu'] directly so this snippet has no section
  dependency.
{%- endcomment -%}

<div class="header__tabs">

  {%- comment -%} MENU drawer trigger {%- endcomment -%}
  <header-drawer data-breakpoint="tablet">
    <details id="Details-menu-drawer-container" class="menu-drawer-container">
      <summary
        class="header__icon header__icon--menu header__icon--summary link focus-inset"
        aria-label="{{ 'sections.header.menu' | t }}"
      >
        <span>
          {{- 'icon-hamburger.svg' | inline_asset_content -}}
          {{- 'icon-close.svg' | inline_asset_content -}}
          <span class="header__label">MENU</span>
        </span>
      </summary>
      <div id="menu-drawer" class="gradient menu-drawer motion-reduce color-scheme-1">
        <div class="menu-drawer__inner-container">
          <div class="menu-drawer__navigation-container">
            <nav class="menu-drawer__navigation">
              <ul class="menu-drawer__menu has-submenu list-menu" role="list">
                {%- for link in linklists['main-menu'].links -%}
                  <li>
                    <a
                      id="HeaderDrawerTabs-{{ link.handle }}"
                      href="{{ link.url }}"
                      class="menu-drawer__menu-item list-menu__item link link--text focus-inset{% if link.current %} menu-drawer__menu-item--active{% endif %}"
                    >
                      {{ link.title | escape }}
                    </a>
                  </li>
                {%- endfor -%}
              </ul>
            </nav>
          </div>
        </div>
      </div>
    </details>
  </header-drawer>

  {%- comment -%} Inline dropdown nav (NEW IN, SHOP, ABOUT, etc.) {%- endcomment -%}
  <nav class="header__inline-menu">
    <ul class="list-menu list-menu--inline" role="list">
      {%- for link in linklists['main-menu'].links -%}
        <li>
          {%- if link.links != blank -%}
            <header-menu>
              <details id="DetailsHeaderMenuTabs-{{ forloop.index }}">
                <summary
                  id="HeaderMenuTabs-{{ link.handle }}"
                  class="header__menu-item list-menu__item link focus-inset"
                >
                  <span{% if link.child_active %} class="header__active-menu-item"{% endif %}>
                    {{- link.title | escape -}}
                  </span>
                  {{- 'icon-caret.svg' | inline_asset_content -}}
                </summary>
                <ul
                  class="header__submenu list-menu list-menu--disclosure color-scheme-1 gradient caption-large motion-reduce global-settings-popup"
                  role="list"
                  tabindex="-1"
                >
                  {%- for childlink in link.links -%}
                    <li>
                      <a
                        id="HeaderMenuTabs-{{ link.handle }}-{{ childlink.handle }}"
                        href="{{ childlink.url }}"
                        class="header__menu-item list-menu__item link link--text focus-inset caption-large{% if childlink.current %} header__active-menu-item{% endif %}"
                      >
                        {{ childlink.title | escape }}
                      </a>
                    </li>
                  {%- endfor -%}
                </ul>
              </details>
            </header-menu>
          {%- else -%}
            <a
              id="HeaderMenuTabs-{{ link.handle }}"
              href="{{ link.url }}"
              class="header__menu-item list-menu__item link link--text focus-inset{% if link.current %} header__active-menu-item{% endif %}"
            >
              {{ link.title | escape }}
            </a>
          {%- endif -%}
        </li>
      {%- endfor -%}
    </ul>
  </nav>

  {%- comment -%} Right cluster: SEARCH + CART {%- endcomment -%}
  <div class="header__icons">
    {% render 'header-search', input_id: 'Search-In-Modal-Tabs' %}

    <a href="{{ routes.cart_url }}" class="header__icon header__icon--cart link focus-inset" id="cart-icon-bubble">
      {% if cart == empty %}
        <span class="svg-wrapper">{{ 'icon-cart-empty.svg' | inline_asset_content }}</span>
      {% else %}
        <span class="svg-wrapper">{{ 'icon-cart.svg' | inline_asset_content }}</span>
      {% endif %}
      <span class="header__label header__label--cart">CART {{ cart.item_count | default: 0 }}</span>
      <span class="visually-hidden">{{ 'templates.cart.cart' | t }}</span>
      {%- if cart != empty -%}
        <div class="cart-count-bubble">
          {%- if cart.item_count < 100 -%}
            <span aria-hidden="true">{{ cart.item_count }}</span>
          {%- endif -%}
          <span class="visually-hidden">{{ 'sections.header.cart_count' | t: count: cart.item_count }}</span>
        </div>
      {%- endif -%}
    </a>
  </div>

</div>
