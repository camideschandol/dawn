{% comment %}
  Poivre Paris — Featured Editorial (PRD §5.1)
  Homepage hero. 2-column on desktop, stacked on mobile (image above text).
  All content editable from theme customizer; no hardcoded copy.
{% endcomment %}

{{ 'section-featured-editorial.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign fetch_priority = 'auto'
  if section.index == 1
    assign fetch_priority = 'high'
  endif
-%}

<section
  class="featured-editorial color-{{ section.settings.color_scheme }} featured-editorial--height-{{ section.settings.height }} featured-editorial--image-{{ section.settings.image_position }}"
  aria-labelledby="FeaturedEditorial-{{ section.id }}-heading"
>
  <div class="featured-editorial__inner">
    <div class="featured-editorial__text">
      {%- if section.settings.eyebrow != blank -%}
        <p class="featured-editorial__eyebrow">{{ section.settings.eyebrow | escape }}</p>
      {%- endif -%}

      {%- if section.settings.heading != blank -%}
        <h1 class="featured-editorial__heading" id="FeaturedEditorial-{{ section.id }}-heading">
          {{ section.settings.heading }}
        </h1>
      {%- endif -%}

      {%- if section.settings.body != blank -%}
        <div class="featured-editorial__body rte">{{ section.settings.body }}</div>
      {%- endif -%}

      {%- if section.settings.cta_label != blank -%}
        <a
          class="featured-editorial__cta"
          {% if section.settings.cta_link != blank %}
            href="{{ section.settings.cta_link }}"
          {% else %}
            role="link" aria-disabled="true"
          {% endif %}
        >
          {{ section.settings.cta_label | escape }}
        </a>
      {%- endif -%}
    </div>

    <div class="featured-editorial__media">
      {%- if section.settings.image != blank -%}
        {%- assign image_widths = '375, 550, 720, 1100, 1440, 1800' -%}
        {%- capture image_sizes -%}
          (min-width: 1100px) 60vw, 100vw
        {%- endcapture -%}
        {{
          section.settings.image
          | image_url: width: 1800
          | image_tag:
            loading: 'eager',
            width: section.settings.image.width,
            height: section.settings.image.height,
            sizes: image_sizes,
            widths: image_widths,
            fetchpriority: fetch_priority,
            alt: section.settings.image.alt | default: section.settings.heading | default: 'Featured editorial'
        }}
      {%- else -%}
        {{ 'lifestyle-1' | placeholder_svg_tag: 'placeholder-svg featured-editorial__placeholder' }}
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Featured editorial",
  "tag": "section",
  "class": "section section-featured-editorial",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow label",
      "info": "Small uppercase label above the headline, e.g. \"Drop 01\". Optional.",
      "default": "DROP 01"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Headline",
      "default": "Quiet luxury, for the way you live now."
    },
    {
      "type": "richtext",
      "id": "body",
      "label": "Body",
      "default": "<p>Poivre is a Paris-rooted home and tableware brand. Curated drops of considered, quietly luxurious objects — made to live with, not collect.</p>"
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "CTA label",
      "default": "EXPLORE THE DROP"
    },
    {
      "type": "url",
      "id": "cta_link",
      "label": "CTA link"
    },
    {
      "type": "header",
      "content": "Image"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Lifestyle image"
    },
    {
      "type": "select",
      "id": "image_position",
      "label": "Image position (desktop)",
      "options": [
        { "value": "right", "label": "Right" },
        { "value": "left", "label": "Left" }
      ],
      "default": "right"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "height",
      "label": "Section height",
      "options": [
        { "value": "medium", "label": "Medium" },
        { "value": "large", "label": "Large" },
        { "value": "full", "label": "Full viewport" }
      ],
      "default": "large"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    }
  ],
  "presets": [
    {
      "name": "Featured editorial"
    }
  ]
}
{% endschema %}
